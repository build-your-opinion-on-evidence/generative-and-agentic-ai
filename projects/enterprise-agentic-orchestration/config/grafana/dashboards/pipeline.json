{
  "uid": "pipeline-dashboard",
  "title": "Pipeline Orchestration Dashboard",
  "panels": [
    {
      "type": "stat",
      "title": "HTTP Requests by Service",
      "targets": [
        {
          "expr": "sum by (service_name) (rate(http_requests_total[5m]))",
          "legendFormat": "{{service_name}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Kafka Events Consumed",
      "targets": [
        {
          "expr": "sum by (topic) (rate(kafka_consumer_messages_total[5m]))",
          "legendFormat": "{{topic}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "API Request Latency",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, service_name))",
          "legendFormat": "{{service_name}} 95th Percentile"
        }
      ],
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "time": {
    "from": "now-1h",
    "to": "now"
  }
}
