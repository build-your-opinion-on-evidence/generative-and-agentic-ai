# =============================================================
# EVENT-DRIVEN MULTI-AGENT FRAUD PLATFORM — ENV EXAMPLE
# =============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================

# --- OpenAI (required for agent execution) ---
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2
OPENAI_TEMPERATURE=0

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_EXTERNAL_PORT=29092

# --- PostgreSQL Shared Password ---
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_USER=fraud_user

# --- Task Manager DB ---
TASK_MANAGER_DB_HOST=postgres-task-manager
TASK_MANAGER_DB_PORT=5432
TASK_MANAGER_DB_NAME=task_manager_db

# --- Orchestrator DB ---
ORCHESTRATOR_DB_HOST=postgres-orchestrator
ORCHESTRATOR_DB_PORT=5432
ORCHESTRATOR_DB_NAME=orchestrator_db

# --- Agent Registry DB ---
AGENT_REGISTRY_DB_HOST=postgres-agent-registry
AGENT_REGISTRY_DB_PORT=5432
AGENT_REGISTRY_DB_NAME=agent_registry_db

# --- Policy DB ---
POLICY_DB_HOST=postgres-policy
POLICY_DB_PORT=5432
POLICY_DB_NAME=policy_db

# --- Approval DB ---
APPROVAL_DB_HOST=postgres-approval
APPROVAL_DB_PORT=5432
APPROVAL_DB_NAME=approval_db

# --- Banking Core DB ---
BANKING_DB_HOST=postgres-banking
BANKING_DB_PORT=5432
BANKING_DB_NAME=banking_core_db

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_VERSION=1.0.0
ENVIRONMENT=local

# --- Demo Settings ---
SEED_AUTO=true
EVENT_SIMULATOR_INTERVAL_SECONDS=10
LOG_LEVEL=INFO
