{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["findings", "recommended_actions", "confidence"],
  "properties": {
    "risk_level": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_type", "description", "evidence"],
        "properties": {
          "finding_type": {"type": "string"},
          "description": {"type": "string"},
          "evidence": {"type": "string"}
        }
      }
    },
    "recommended_actions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "summary": {"type": "string"}
  }
}
